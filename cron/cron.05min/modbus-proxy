#!/bin/bash

# Lässt das Steuerskript alle 5 Minuten die Grösse der Logdatei prüfen und sie bei
# Bedarf kürzen. Wird von LoxBerry als User loxberry aufgerufen (/etc/cron.d/lbdefaults).

MAILTO=""

# Liest die LoxBerry-Variablen ein, die Cron nicht zuverlässig vererbt.
set -a
. /etc/environment
set +a

CTL="$LBPBIN/modbus-proxy/modbus-proxy-ctl.sh"

[ -x "$CTL" ] && "$CTL" trimlog

exit 0
