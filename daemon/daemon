#!/bin/bash

# Wird von LoxBerry beim Systemstart als root ausgeführt (system/daemons/plugins/).
# Startet den modbus-proxy-Dienst über das Steuerskript (läuft dort als User loxberry).
# Die Ausgabe wird verworfen; das Steuerskript schreibt Start- und Fehlermeldungen
# selbst in die Logdatei des Plugins.

"$LBPBIN/modbus-proxy/modbus-proxy-ctl.sh" start >/dev/null 2>&1

exit 0
